<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Prefixed HKV TG-9801 gripper. Geometry copied from
    fairino_description/urdf/hkv_gripper.xacro (frcobot_ros2 @ c6f86a1).
    Mesh paths stay in fairino_description. TCP remains 0.150 m from the
    gripper base along +Z.
  -->

  <xacro:macro name="hkv_mesh" params="file">
    <geometry>
      <mesh filename="package://fairino_description/meshes/hkv_gripper/${file}"
            scale="0.001 0.001 0.001"/>
    </geometry>
  </xacro:macro>

  <xacro:macro name="hkv_box_inertia" params="mass sx sy sz">
    <inertia
        ixx="${mass * (sy*sy + sz*sz) / 12.0}"
        ixy="0"
        ixz="0"
        iyy="${mass * (sx*sx + sz*sz) / 12.0}"
        iyz="0"
        izz="${mass * (sx*sx + sy*sy) / 12.0}"/>
  </xacro:macro>

  <xacro:macro
      name="hkv_gripper_prefixed"
      params="prefix parent mount_xyz:='0 0 0.100' mount_rpy:='0 0 0' gripper_closed_position:=0.1">

    <xacro:property name="closed_pos" value="${float(gripper_closed_position)}"/>
    <xacro:property name="half_travel" value="${closed_pos / 2.0}"/>

    <material name="${prefix}hkv_metal">
      <color rgba="0.58 0.58 0.58 1"/>
    </material>
    <material name="${prefix}hkv_silicone">
      <color rgba="0.1882 0.1882 0.1882 1"/>
    </material>

    <link name="${prefix}gripper_base_link">
      <visual>
        <origin xyz="0 0 0.0615" rpy="0 0 0"/>
        <xacro:hkv_mesh file="base_body.stl"/>
        <material name="${prefix}hkv_silicone"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.0615" rpy="0 0 0"/>
        <xacro:hkv_mesh file="base_body.stl"/>
      </collision>
      <inertial>
        <origin xyz="0 0 0.037" rpy="0 0 0"/>
        <mass value="0.45"/>
        <xacro:hkv_box_inertia mass="0.45" sx="0.160" sy="0.071" sz="0.074"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base_link"/>
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
    </joint>

    <link name="${prefix}rail_155">
      <visual>
        <origin xyz="0 0 0.070" rpy="0 0 0"/>
        <xacro:hkv_mesh file="rail_155.stl"/>
        <material name="${prefix}hkv_metal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.070" rpy="0 0 0"/>
        <xacro:hkv_mesh file="rail_155.stl"/>
      </collision>
      <inertial>
        <origin xyz="0 0 0.0724" rpy="0 0 0"/>
        <mass value="0.04"/>
        <xacro:hkv_box_inertia mass="0.04" sx="0.155" sy="0.007" sz="0.005"/>
      </inertial>
    </link>

    <joint name="${prefix}base_2_rail" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}rail_155"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}slider_r">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:hkv_mesh file="slider.stl"/>
        <material name="${prefix}hkv_metal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:hkv_mesh file="slider.stl"/>
      </collision>
      <inertial>
        <origin xyz="0 0 0.00485" rpy="0 0 0"/>
        <mass value="0.03"/>
        <xacro:hkv_box_inertia mass="0.03" sx="0.024" sy="0.017" sz="0.0065"/>
      </inertial>
    </link>

    <link name="${prefix}slider_l">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:hkv_mesh file="slider.stl"/>
        <material name="${prefix}hkv_metal"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:hkv_mesh file="slider.stl"/>
      </collision>
      <inertial>
        <origin xyz="0 0 0.00485" rpy="0 0 0"/>
        <mass value="0.03"/>
        <xacro:hkv_box_inertia mass="0.03" sx="0.024" sy="0.017" sz="0.0065"/>
      </inertial>
    </link>

    <link name="${prefix}finger_r">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:hkv_mesh file="finger.stl"/>
        <material name="${prefix}hkv_silicone"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:hkv_mesh file="finger.stl"/>
      </collision>
      <inertial>
        <origin xyz="0.00225 0 0.03585" rpy="0 0 0"/>
        <mass value="0.05"/>
        <xacro:hkv_box_inertia mass="0.05" sx="0.0285" sy="0.040" sz="0.0717"/>
      </inertial>
    </link>

    <link name="${prefix}finger_l">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:hkv_mesh file="finger.stl"/>
        <material name="${prefix}hkv_silicone"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:hkv_mesh file="finger.stl"/>
      </collision>
      <inertial>
        <origin xyz="0.00225 0 0.03585" rpy="0 0 0"/>
        <mass value="0.05"/>
        <xacro:hkv_box_inertia mass="0.05" sx="0.0285" sy="0.040" sz="0.0717"/>
      </inertial>
    </link>

    <link name="${prefix}gripper_gap_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_joint" type="prismatic">
      <parent link="${prefix}rail_155"/>
      <child link="${prefix}gripper_gap_link"/>
      <origin xyz="0 0 0.070" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="${closed_pos}" effort="1000.0" velocity="0.5"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <joint name="${prefix}rail_2_slider_l" type="prismatic">
      <parent link="${prefix}rail_155"/>
      <child link="${prefix}slider_l"/>
      <origin xyz="-0.06545 0 0.070" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="${half_travel}" effort="1000.0" velocity="0.5"/>
      <dynamics damping="0.1" friction="0.0"/>
      <mimic joint="${prefix}gripper_joint" multiplier="0.5" offset="0.0"/>
    </joint>

    <joint name="${prefix}rail_2_slider_r" type="prismatic">
      <parent link="${prefix}rail_155"/>
      <child link="${prefix}slider_r"/>
      <origin xyz="0.06545 0 0.070" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-${half_travel}" upper="0" effort="1000.0" velocity="0.5"/>
      <dynamics damping="0.1" friction="0.0"/>
      <mimic joint="${prefix}gripper_joint" multiplier="-0.5" offset="0.0"/>
    </joint>

    <joint name="${prefix}slider_2_finger_r" type="fixed">
      <parent link="${prefix}slider_r"/>
      <child link="${prefix}finger_r"/>
      <origin xyz="0 0 0.008" rpy="0 0 3.1415927"/>
    </joint>

    <joint name="${prefix}slider_2_finger_l" type="fixed">
      <parent link="${prefix}slider_l"/>
      <child link="${prefix}finger_l"/>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_tcp"/>

    <joint name="${prefix}gripper_tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_tcp"/>
      <origin xyz="0 0 0.150" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
