<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dual-arm SRDF for fairino3_dual_robot.

  Intra-arm disable_collisions copy the current single-arm matrix
  (fairino3_v6_robot.real.srdf) with prefixes.

  There are NO disable_collisions entries between Arm A and Arm B.
  Cross-arm pairs stay at the default "always check".
-->
<robot name="fairino3_dual_robot">

  <group name="arm_a">
    <joint name="arm_a_j1"/>
    <joint name="arm_a_j2"/>
    <joint name="arm_a_j3"/>
    <joint name="arm_a_j4"/>
    <joint name="arm_a_j5"/>
    <joint name="arm_a_j6"/>
    <chain base_link="arm_a_base_link" tip_link="arm_a_gripper_tcp"/>
  </group>

  <group name="arm_b">
    <joint name="arm_b_j1"/>
    <joint name="arm_b_j2"/>
    <joint name="arm_b_j3"/>
    <joint name="arm_b_j4"/>
    <joint name="arm_b_j5"/>
    <joint name="arm_b_j6"/>
    <chain base_link="arm_b_base_link" tip_link="arm_b_gripper_tcp"/>
  </group>

  <group name="dual_arms">
    <group name="arm_a"/>
    <group name="arm_b"/>
  </group>

  <group name="arm_a_gripper">
    <joint name="arm_a_gripper_joint"/>
  </group>

  <group name="arm_b_gripper">
    <joint name="arm_b_gripper_joint"/>
  </group>

  <end_effector
      name="arm_a_hkv_gripper"
      parent_link="arm_a_gripper_tcp"
      group="arm_a_gripper"
      parent_group="arm_a"/>

  <end_effector
      name="arm_b_hkv_gripper"
      parent_link="arm_b_gripper_tcp"
      group="arm_b_gripper"
      parent_group="arm_b"/>

  <group_state name="home" group="arm_a">
    <joint name="arm_a_j1" value="0"/>
    <joint name="arm_a_j2" value="0"/>
    <joint name="arm_a_j3" value="0"/>
    <joint name="arm_a_j4" value="0"/>
    <joint name="arm_a_j5" value="0"/>
    <joint name="arm_a_j6" value="0"/>
  </group_state>

  <group_state name="home" group="arm_b">
    <joint name="arm_b_j1" value="0"/>
    <joint name="arm_b_j2" value="0"/>
    <joint name="arm_b_j3" value="0"/>
    <joint name="arm_b_j4" value="0"/>
    <joint name="arm_b_j5" value="0"/>
    <joint name="arm_b_j6" value="0"/>
  </group_state>

  <group_state name="open" group="arm_a_gripper">
    <joint name="arm_a_gripper_joint" value="0"/>
  </group_state>
  <group_state name="closed" group="arm_a_gripper">
    <joint name="arm_a_gripper_joint" value="0.1"/>
  </group_state>
  <group_state name="open" group="arm_b_gripper">
    <joint name="arm_b_gripper_joint" value="0"/>
  </group_state>
  <group_state name="closed" group="arm_b_gripper">
    <joint name="arm_b_gripper_joint" value="0.1"/>
  </group_state>

  <passive_joint name="arm_a_rail_2_slider_l"/>
  <passive_joint name="arm_a_rail_2_slider_r"/>
  <passive_joint name="arm_b_rail_2_slider_l"/>
  <passive_joint name="arm_b_rail_2_slider_r"/>

  <!-- Arm A intra-arm only -->
  <disable_collisions link1="arm_a_base_link" link2="arm_a_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="arm_a_base_link" link2="arm_a_upperarm_link" reason="Never"/>
  <disable_collisions link1="arm_a_forearm_link" link2="arm_a_upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_a_forearm_link" link2="arm_a_wrist1_link" reason="Adjacent"/>
  <disable_collisions link1="arm_a_shoulder_link" link2="arm_a_upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_a_shoulder_link" link2="arm_a_wrist1_link" reason="Never"/>
  <disable_collisions link1="arm_a_wrist1_link" link2="arm_a_wrist2_link" reason="Adjacent"/>
  <disable_collisions link1="arm_a_wrist1_link" link2="arm_a_wrist3_link" reason="Never"/>
  <disable_collisions link1="arm_a_wrist2_link" link2="arm_a_wrist3_link" reason="Adjacent"/>
  <disable_collisions link1="arm_a_wrist3_link" link2="arm_a_gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="arm_a_wrist3_link" link2="arm_a_rail_155" reason="Adjacent"/>
  <disable_collisions link1="arm_a_gripper_base_link" link2="arm_a_rail_155" reason="Adjacent"/>
  <disable_collisions link1="arm_a_gripper_base_link" link2="arm_a_gripper_gap_link" reason="Adjacent"/>
  <disable_collisions link1="arm_a_gripper_base_link" link2="arm_a_slider_l" reason="Adjacent"/>
  <disable_collisions link1="arm_a_gripper_base_link" link2="arm_a_slider_r" reason="Adjacent"/>
  <disable_collisions link1="arm_a_gripper_base_link" link2="arm_a_finger_l" reason="Adjacent"/>
  <disable_collisions link1="arm_a_gripper_base_link" link2="arm_a_finger_r" reason="Adjacent"/>
  <disable_collisions link1="arm_a_rail_155" link2="arm_a_gripper_gap_link" reason="Adjacent"/>
  <disable_collisions link1="arm_a_rail_155" link2="arm_a_slider_l" reason="Adjacent"/>
  <disable_collisions link1="arm_a_rail_155" link2="arm_a_slider_r" reason="Adjacent"/>
  <disable_collisions link1="arm_a_rail_155" link2="arm_a_finger_l" reason="Never"/>
  <disable_collisions link1="arm_a_rail_155" link2="arm_a_finger_r" reason="Never"/>
  <disable_collisions link1="arm_a_slider_l" link2="arm_a_finger_l" reason="Adjacent"/>
  <disable_collisions link1="arm_a_slider_r" link2="arm_a_finger_r" reason="Adjacent"/>
  <disable_collisions link1="arm_a_slider_l" link2="arm_a_gripper_gap_link" reason="Never"/>
  <disable_collisions link1="arm_a_slider_r" link2="arm_a_gripper_gap_link" reason="Never"/>
  <disable_collisions link1="arm_a_finger_l" link2="arm_a_gripper_gap_link" reason="Never"/>
  <disable_collisions link1="arm_a_finger_r" link2="arm_a_gripper_gap_link" reason="Never"/>

  <!-- Arm B intra-arm only -->
  <disable_collisions link1="arm_b_base_link" link2="arm_b_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="arm_b_base_link" link2="arm_b_upperarm_link" reason="Never"/>
  <disable_collisions link1="arm_b_forearm_link" link2="arm_b_upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_b_forearm_link" link2="arm_b_wrist1_link" reason="Adjacent"/>
  <disable_collisions link1="arm_b_shoulder_link" link2="arm_b_upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_b_shoulder_link" link2="arm_b_wrist1_link" reason="Never"/>
  <disable_collisions link1="arm_b_wrist1_link" link2="arm_b_wrist2_link" reason="Adjacent"/>
  <disable_collisions link1="arm_b_wrist1_link" link2="arm_b_wrist3_link" reason="Never"/>
  <disable_collisions link1="arm_b_wrist2_link" link2="arm_b_wrist3_link" reason="Adjacent"/>
  <disable_collisions link1="arm_b_wrist3_link" link2="arm_b_gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="arm_b_wrist3_link" link2="arm_b_rail_155" reason="Adjacent"/>
  <disable_collisions link1="arm_b_gripper_base_link" link2="arm_b_rail_155" reason="Adjacent"/>
  <disable_collisions link1="arm_b_gripper_base_link" link2="arm_b_gripper_gap_link" reason="Adjacent"/>
  <disable_collisions link1="arm_b_gripper_base_link" link2="arm_b_slider_l" reason="Adjacent"/>
  <disable_collisions link1="arm_b_gripper_base_link" link2="arm_b_slider_r" reason="Adjacent"/>
  <disable_collisions link1="arm_b_gripper_base_link" link2="arm_b_finger_l" reason="Adjacent"/>
  <disable_collisions link1="arm_b_gripper_base_link" link2="arm_b_finger_r" reason="Adjacent"/>
  <disable_collisions link1="arm_b_rail_155" link2="arm_b_gripper_gap_link" reason="Adjacent"/>
  <disable_collisions link1="arm_b_rail_155" link2="arm_b_slider_l" reason="Adjacent"/>
  <disable_collisions link1="arm_b_rail_155" link2="arm_b_slider_r" reason="Adjacent"/>
  <disable_collisions link1="arm_b_rail_155" link2="arm_b_finger_l" reason="Never"/>
  <disable_collisions link1="arm_b_rail_155" link2="arm_b_finger_r" reason="Never"/>
  <disable_collisions link1="arm_b_slider_l" link2="arm_b_finger_l" reason="Adjacent"/>
  <disable_collisions link1="arm_b_slider_r" link2="arm_b_finger_r" reason="Adjacent"/>
  <disable_collisions link1="arm_b_slider_l" link2="arm_b_gripper_gap_link" reason="Never"/>
  <disable_collisions link1="arm_b_slider_r" link2="arm_b_gripper_gap_link" reason="Never"/>
  <disable_collisions link1="arm_b_finger_l" link2="arm_b_gripper_gap_link" reason="Never"/>
  <disable_collisions link1="arm_b_finger_r" link2="arm_b_gripper_gap_link" reason="Never"/>

</robot>
